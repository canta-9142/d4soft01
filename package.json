{
    "type": "module",
    "scripts": {
        "dev:css": "tailwindcss -i ./src/tailwind.css -o ./dist/tailwind.css --watch",
        "build:css": "tailwindcss -i ./src/tailwind.css -o ./dist/tailwind.css --minify",
        "dev:ts": "tsc --watch",
        "build:ts": "tsc",
        "dev": "concurrently \"npm run dev:css\" \"npm run dev:ts\"",
        "serve": "python3 -m http.server 8000",
        "build": "npm run build:css && npm run build:ts",
        "test": "npm run build:ts && node --test --test-isolation=none test/*.test.mjs"
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.3.2",
        "concurrently": "^10.0.3",
        "tailwindcss": "^4.3.2",
        "typescript": "^6.0.3"
    }
}
